# WigAI Development Environment Variables
#
# Copy this file to .env.local and update with your actual values.
# .env.local is ignored by git — never commit secrets to version control.
#
# Usage:
#   cp .env.example .env.local
#   source .env.local
#   # Run your development commands

# ============================================================================
# Optional: Customize MCP Endpoints
# ============================================================================

# WigAI MCP endpoint URL (used by devcontainer to reach Bitwig on host)
# Default: http://host.docker.internal:61169/mcp
# WIGAI_MCP_URL="http://host.docker.internal:61169/mcp"

# codegraphcontext version (install-codegraphcontext.sh respects this)
# Default: 0.6.3
# CGC_VERSION="0.6.3"

# ============================================================================
# Optional: Host Network Configuration (Linux only)
# ============================================================================

# If running Docker on Linux and host.docker.internal doesn't resolve,
# set WIGAI_HOST_IP to your host machine's IP address:
# WIGAI_HOST_IP="192.168.1.100"
# Then update .vscode/mcp.json to use: http://${WIGAI_HOST_IP}:61169/mcp

# ============================================================================
# Optional: Bitwig Studio Configuration
# ============================================================================

# Bitwig Studio MCP server port (must match Bitwig settings)
# BITWIG_MCP_PORT="61169"

# ============================================================================
# IMPORTANT: Never commit credentials, API keys, or tokens to git
# ============================================================================
# If you add secrets here, make sure:
# 1. This file remains in .gitignore
# 2. You never commit .env or .env.local
# 3. You document secrets in README or setup guide for team onboarding

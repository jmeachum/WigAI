# VS Code
# Ignore per-developer workspace files, but keep the shared MCP server
# config repo-managed (Epic 7). A `!` negation cannot re-include a file
# whose parent directory is excluded, so exclude the contents, not the dir.
.vscode/*
!.vscode/mcp.json
.code-workspace


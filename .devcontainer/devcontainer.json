{
  "name": "wigai",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "features": {
    "ghcr.io/anthropics/devcontainer-features/claude-code:1": {},
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/devcontainers/features/java:1": {
      "version": "21",
      "jdkDistro": "tem",
      "installGradle": false
    },
    "ghcr.io/devcontainers/features/python:1": {
      "version": "3.12",
      "installTools": false
    }
  },
  "containerUser": "root",
  "remoteUser": "vscode",
  "mounts": [
    "type=volume,source=wigai-home-41d1b89c,target=/home/vscode"
  ],
  "onCreateCommand": "mkdir -p /home/vscode/.npm-global && chown -R vscode:vscode /home/vscode",
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "containerEnv": {
    "JAVA_HOME": "/usr/local/sdkman/candidates/java/current"
  },
  "remoteEnv": {
    "PATH": "/usr/local/sdkman/candidates/java/current/bin:${containerEnv:PATH}"
  }
}
